# Public site origin — no trailing slash.
# Drives canonical URLs, Open Graph / Twitter tags, robots.txt, sitemap.xml,
# and JSON-LD structured data. Falls back to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=https://example.com

# --- Server-only (no NEXT_PUBLIC_ prefix — never exposed to the browser) ---

# Optional upstream the /api/contact route forwards leads to (CRM / webhook).
# When unset, the route logs submissions server-side instead.
CONTACT_ENDPOINT=

# --- Catalogue storage ---
# Leave these empty and the admin saves products to .data/products.json and
# photos to public/assets/produtos/ — zero setup, but needs a writable disk.
# Fill them in and the admin saves to Supabase instead, which works on
# serverless hosts (Vercel) where the filesystem is read-only.
# The service-role key bypasses row-level security: server-only, never
# NEXT_PUBLIC_, never committed.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

# --- Admin access ---
# The FIRST access, created once on first run. After that, accesses are managed
# in the admin itself (/admin/acessos) and these are not read again.
# While no access exists, /admin is open to anyone with the URL.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
